# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WHATSAPP_PROVIDER: Optional gateway ('simulated' | 'fonnte' | 'meta_cloud' | 'webhook')
WHATSAPP_PROVIDER="simulated"

# WHATSAPP_API_TOKEN: Server-side API token for Fonnte, Meta Cloud API, or Webhook bearer auth
WHATSAPP_API_TOKEN=""

# WHATSAPP_PHONE_NUMBER_ID: Meta WhatsApp Cloud API phone number ID (if using meta_cloud)
WHATSAPP_PHONE_NUMBER_ID=""

# WHATSAPP_WEBHOOK_URL: Custom webhook URL (if using webhook provider)
WHATSAPP_WEBHOOK_URL=""
